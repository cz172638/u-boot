# RK3308 lab mode, on top of rk3308-debug.config: empty default environment
# (only comments in rk3308-debug.env.txt), no autoboot, stop at the prompt.
#   make rock-pi-s-rk3308_defconfig rk3308-debug.config rk3308-lab.config
# Without it U-Boot boots as usual (bootflow scan, extlinux from SD card).
# CONFIG_AUTOBOOT is not set
# CONFIG_USE_BOOTCOMMAND is not set
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/rockchip/evb_rk3308/rk3308-debug.env.txt"
