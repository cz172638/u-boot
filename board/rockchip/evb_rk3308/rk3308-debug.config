# RK3308 debug build: keep JTAG/SWD usable and make software breakpoints
# and memory tests easy.
#   make rock-pi-s-rk3308_defconfig rk3308-debug.config
# Pair it with TF-A built with DEBUG=1 (RK3308_JTAG=1).
CONFIG_ROCKCHIP_RK3308_DEBUG_JTAG=y
# no watchdog in U-Boot, nothing that resets the SoC under the debugger
# CONFIG_WDT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_SPL_WDT is not set
# caches off in SPL: software breakpoints in SPL stay coherent
CONFIG_SPL_SYS_ICACHE_OFF=y
CONFIG_SPL_SYS_DCACHE_OFF=y
CONFIG_DEBUG_UART_ANNOUNCE=y
# hang instead of resetting on panic, so the state can be inspected
CONFIG_PANIC_HANG=y
CONFIG_CMD_MEMTEST=y
# CONFIG_SYS_ALT_MEMTEST is not set
CONFIG_SYS_MEMTEST_START=0x00200000
CONFIG_SYS_MEMTEST_END=0x0a000000
# lab mode: empty default environment, no autoboot, stop at the prompt
# CONFIG_AUTOBOOT is not set
# CONFIG_USE_BOOTCOMMAND is not set
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/rockchip/evb_rk3308/rk3308-debug.env.txt"
# OP-TEE (rockchip-rk3308 flavor): 16 MiB TZDRAM at 0x0a000000.
# OPTEE_LIB is set here explicitly: otherwise it only turns on when TEE= is
# given to make (HAS_TEE_IN_BUILD_ENV), and if that happens only at build
# time and not at configure time, Kconfig stops at the OPTEE_TZDRAM_SIZE
# prompt. It also copies OP-TEE's DT nodes into the kernel DT on boot.
CONFIG_OPTEE_LIB=y
CONFIG_OPTEE_TZDRAM_SIZE=0x01000000
